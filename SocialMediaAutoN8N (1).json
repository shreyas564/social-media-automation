    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst posts = [];\n\nconst postid = $('Webhook').first().json.body.post_id;\nconst caption = $('AI Agent').first().json.output;\n\nfor (const item of items) {\n\n  const data = item.json;\n\n  // =========================\n  // FACEBOOK (Image + Video)\n  // =========================\n  if (data.permalink_url && data.permalink_url.includes('facebook')) {\n    posts.push({\n      postid,\n      platform: 'facebook',\n      post_id: data.id || null,\n      post_url: data.permalink_url,\n    });\n  }\n\n  // =========================\n  // INSTAGRAM (Image + Video)\n  // =========================\n  else if (data.permalink && data.permalink.includes('instagram')) {\n    posts.push({\n      postid,\n      platform: 'instagram',\n      post_id: data.id || null,\n      post_url: data.permalink,\n    });\n  }\n\n  // =========================\n  // LINKEDIN\n  // =========================\n else if (\n  (data.urn && data.urn.startsWith('urn:li:share')) ||\n  (data.id && data.id.startsWith('urn:li:ugcPost'))\n) {\n  const urn = data.urn || data.id;\n\n  posts.push({\n    postid,\n    platform: 'linkedin',\n    post_id: urn,\n    post_url: `https://www.linkedin.com/feed/update/${urn}/`,\n  });\n}\n\n    \n  \n}\n\nreturn [\n  {\n    json: {\n      postid,\n      caption,\n      posts,\n    },\n  },\n];\n\n"
      },
      "type": "n8n-nodes-base.code",
